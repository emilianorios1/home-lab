# Development only. Production has its own file, database, volume and credentials.
POSTGRES_DB=home_lab_dev
POSTGRES_USER=home_lab_dev
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://home_lab_dev:change-me-for-local-development@localhost:5432/home_lab_dev
HOME_LAB_DEV_POSTGRES_PORT=5432
HOME_LAB_DEV_DASHBOARD_PORT=8502
HOME_LAB_OPERATIONS_PASSWORD=change-me-for-local-development

# Gmail read-only ingestion
GMAIL_CLIENT_SECRET_PATH=secrets/gmail_client_secret.json
GMAIL_TOKEN_PATH=secrets/gmail_token.json
GMAIL_QUERY={from:no_reply@zetace.com.ar from:oficinavirtual@epe.santafe.gov.ar from:facturadigital@aguassantafesinas.com from:factura@digital.litoralgas.com.ar from:avisos@info.naranjax.com from:noreply@iplan.com.ar} newer_than:45d
DOCUMENT_STORE_PATH=data/bronze/gmail
DOCUMENT_MAX_BYTES=20971520

# Optional current annual ceiling for the user's monotributo category.
# Keep it operator-configured because ARCA updates category limits.
MONOTRIBUTO_ANNUAL_LIMIT_ARS=

# Afip SDK access token for the WSFEX development sandbox.
# Never commit a real token. Revoke it immediately if it is exposed.
AFIP_SDK_ACCESS_TOKEN=

# Rosario SIAT TGI account and personal management code
SIAT_TGI_ACCOUNT=replace-with-account-number
SIAT_TGI_MANAGEMENT_CODE=replace-with-personal-management-code

# Mercado Pago production credential (keep this only in .env)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-replace-with-your-production-access-token

# Copy this file to ~/.config/home-lab/prod.env and chmod it to 600.
# scripts/install-production.sh creates a secure version automatically.
POSTGRES_DB=home_lab_prod
POSTGRES_USER=home_lab_prod
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The dashboard is intentionally available to the LAN on port 8501.
HOME_LAB_PROD_BIND=0.0.0.0
HOME_LAB_PROD_PORT=8501
HOME_LAB_PROD_DATA_DIR=/home/your-user/.local/share/home-lab/production
HOME_LAB_PROD_SECRETS_DIR=/home/your-user/.config/home-lab/secrets
HOME_LAB_BACKUP_DIR=/home/your-user/.local/share/home-lab/backups
HOME_LAB_BACKUP_RETENTION_DAYS=14
HOME_LAB_HOST_UID=1000
HOME_LAB_HOST_GID=1000

# Optional ingestion credentials, used only by the on-demand tools container.
GMAIL_QUERY={from:no_reply@zetace.com.ar from:oficinavirtual@epe.santafe.gov.ar from:facturadigital@aguassantafesinas.com from:factura@digital.litoralgas.com.ar from:avisos@info.naranjax.com} newer_than:45d
DOCUMENT_MAX_BYTES=20971520
SIAT_TGI_ACCOUNT=
SIAT_TGI_MANAGEMENT_CODE=
MERCADOPAGO_ACCESS_TOKEN=
